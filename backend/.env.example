DATABASE_URL=postgresql+psycopg://user:password@localhost/telematics_db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_EMBED_MODEL=nomic-embed-text
JWT_SECRET=your-secret-key-here
SESSION_TIMEOUT_MINUTES=30
ESCALATION_CONFIDENCE_THRESHOLD=0.6
# Comma-separated list of origins allowed to make cross-origin requests to
# this API (see CORSMiddleware in app/main.py). Defaults to the Vite dev
# server and the Docker Compose frontend service if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
