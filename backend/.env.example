DATABASE_URL=postgresql+psycopg://user:password@localhost/telematics_db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
JWT_SECRET=your-secret-key-here
# Base64-encoded symmetric key (>=32 raw bytes) for at-rest PII encryption
# (Customer.email/full_name/phone_number -- see backend/app/security/crypto.py).
# The value below is a throwaway example key (valid base64, decodes to
# exactly 32 bytes) so the documented `cp .env.example .env` quickstart
# works out of the box -- CHANGE THIS IN PRODUCTION by generating your own:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=iORXzBuWgphgbO34uxb0Eygl1cT/Bna17B+cKXFl35o=
SESSION_TIMEOUT_MINUTES=30
ESCALATION_CONFIDENCE_THRESHOLD=0.6
# Comma-separated list of origins allowed to make cross-origin requests to
# this API (see CORSMiddleware in app/main.py). Defaults to the Vite dev
# server and the Docker Compose frontend service if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
