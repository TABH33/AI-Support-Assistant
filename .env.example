# PostgreSQL Configuration
POSTGRES_USER=telematics_user
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=telematics_db

# Database URL for Backend
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql+psycopg://telematics_user:secure_password_change_me@postgres:5432/telematics_db

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2
OLLAMA_EMBED_MODEL=nomic-embed-text

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-change-me-in-production

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# Escalation Configuration
# AI chat answers with a confidence score below this threshold are escalated
# to a human support ticket instead of being shown to the customer.
ESCALATION_CONFIDENCE_THRESHOLD=0.6

# CORS Configuration
# Comma-separated list of origins allowed to make cross-origin requests to
# the backend. Must match wherever the frontend is actually served from.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
# No /api prefix -- the backend mounts routers at the root (e.g.
# POST /auth/login), see backend/app/main.py.
VITE_API_BASE_URL=http://localhost:8000
