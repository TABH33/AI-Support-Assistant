# PostgreSQL Configuration
POSTGRES_USER=telematics_user
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=telematics_db

# Database URL for Backend
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql+psycopg://telematics_user:secure_password_change_me@postgres:5432/telematics_db

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-change-me-in-production

# Encryption Configuration
# Base64-encoded symmetric key (>=32 raw bytes) used to encrypt PII columns
# (Customer.email/full_name/phone_number) at rest -- see
# backend/app/security/crypto.py. The value below is a throwaway example key
# (valid base64, decodes to exactly 32 bytes) so the documented `cp
# .env.example .env` quickstart works out of the box -- CHANGE THIS IN
# PRODUCTION by generating your own:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing/rotating this key without a re-encryption migration makes existing
# encrypted rows permanently undecryptable -- back it up like any other
# production secret.
ENCRYPTION_KEY=xtoqmVxFsnmi1p3AP/PojvdHRebEwG1ZNboymXSW41E=

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# Escalation Configuration
# AI chat answers with a confidence score below this threshold are escalated
# to a human support ticket instead of being shown to the customer.
ESCALATION_CONFIDENCE_THRESHOLD=0.6

# CORS Configuration
# Comma-separated list of origins allowed to make cross-origin requests to
# the backend. Must match wherever the frontend is actually served from.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
# No /api prefix -- the backend mounts routers at the root (e.g.
# POST /auth/login), see backend/app/main.py.
VITE_API_BASE_URL=http://localhost:8000
