# PostgreSQL Configuration
POSTGRES_USER=telematics_user
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=telematics_db

# Database URL for Backend
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql+psycopg://telematics_user:secure_password_change_me@postgres:5432/telematics_db

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-change-me-in-production

# Encryption Configuration
# Base64-encoded symmetric key (>=32 raw bytes) used to encrypt PII columns
# (Customer.email/full_name/phone_number) at rest -- see
# backend/app/security/crypto.py. The value below is a throwaway example key
# (valid base64, decodes to exactly 32 bytes) so the documented `cp
# .env.example .env` quickstart works out of the box -- CHANGE THIS IN
# PRODUCTION by generating your own:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing/rotating this key without a re-encryption migration makes existing
# encrypted rows permanently undecryptable -- back it up like any other
# production secret.
ENCRYPTION_KEY=xtoqmVxFsnmi1p3AP/PojvdHRebEwG1ZNboymXSW41E=

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# Escalation Configuration
# AI chat answers with a confidence score below this threshold are replaced
# with a fixed fallback message, and the customer is OFFERED escalation to a
# human. A support ticket (and email, if SMTP is configured below) is only
# created if they say yes -- see POST /chat/messages/{id}/escalate.
ESCALATION_CONFIDENCE_THRESHOLD=0.6

# OpenRouteService API key (route-planning feature: directions + geocoding).
# Free-tier signup at https://openrouteservice.org/dev/#/signup -- no
# billing required. Leave blank to run without the route-planning feature;
# POST /route-plan and the chat route-plan intent will report route data
# as unavailable rather than erroring.
ORS_API_KEY=

# Opt-in chat escalation email (app/integrations/email.py). When a customer
# accepts the chat widget's "escalate this to a human?" offer, a support
# ticket is always created; an email is ALSO sent to ESCALATION_EMAIL_TO if
# SMTP_HOST is set. Leave SMTP_HOST blank to run without email (the API then
# reports email_sent=false). SMTP_USE_TLS=true means STARTTLS on SMTP_PORT
# (587 is the standard submission port). SMTP_FROM_ADDRESS falls back to
# SMTP_USERNAME when blank. Never commit a real SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
ESCALATION_EMAIL_TO=CIHE241731@student.edu.cihe.au

# CORS Configuration
# Comma-separated list of origins allowed to make cross-origin requests to
# the backend. Must match wherever the frontend is actually served from.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
# No /api prefix -- the backend mounts routers at the root (e.g.
# POST /auth/login), see backend/app/main.py.
VITE_API_BASE_URL=http://localhost:8000
