# PostgreSQL Configuration
POSTGRES_USER=telematics_user
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=telematics_db

# Database URL for Backend
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql+psycopg://telematics_user:secure_password_change_me@postgres:5432/telematics_db

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2
OLLAMA_EMBED_MODEL=nomic-embed-text

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-change-me-in-production

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
